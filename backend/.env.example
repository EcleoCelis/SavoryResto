# Database Connection
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/restaurant_db

# Frontend Application Origin (used for CORS and constructing password reset links)
FRONTEND_URL=http://localhost:3000

# Application Environment (development, testing, production)
ENVIRONMENT=development
# COOKIE_SECURE=true  # Defaults to true when ENVIRONMENT=production

# Reverse Proxy and Network Hardening
# Comma-separated list of trusted upstream proxy IPs (e.g. Nginx, Cloudflare, AWS ALB)
TRUSTED_PROXIES=127.0.0.1,::1

# Additional Allowed CORS Origins (comma-separated, FRONTEND_URL is always included)
# ALLOWED_CORS_ORIGINS=https://savorybites.com,https://admin.savorybites.com

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STAFF_ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_DAYS=30

# Password Reset & Account Recovery
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_MINUTES=15
PASSWORD_RESET_MAX_PER_EMAIL=3
PASSWORD_RESET_MAX_PER_IP=10

# Transactional Email / SMTP Configuration
# When SMTP_HOST is not set, emails are dispatched to dev/test memory logger.
# For production delivery, configure your SMTP server details below:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@savorybites.com
EMAILS_FROM_NAME=SavoryBites Restaurant
